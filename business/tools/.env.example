# Copy to .env (same folder) and fill in what you have. Every line is optional.
# .env is gitignored. Never commit real keys: this repo is public.

# Claude: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# ChatGPT: platform.openai.com -> API keys (a ChatGPT Plus subscription does not include API credit)
OPENAI_API_KEY=
# Gemini: aistudio.google.com -> Get API key (has a free tier)
GEMINI_API_KEY=
# Perplexity: perplexity.ai/settings/api (Pro subscribers get monthly API credit)
PERPLEXITY_API_KEY=

# Free local model. Install Ollama (ollama.com), then: ollama pull llama3.1:8b
# LM Studio users: LOCAL_URL=http://localhost:1234/v1
LOCAL_MODEL=llama3.1:8b
LOCAL_URL=http://localhost:11434/v1

# Model names change every few months. Override here instead of editing code.
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5
# GEMINI_MODEL=gemini-2.5-flash
# PERPLEXITY_MODEL=sonar-pro

# Stripe Payment Links, used in the report email that autopilot.py drafts
STRIPE_FIXPLAN_LINK=
STRIPE_RETAINER_LINK=

# scout.py reads Upwork and F5Bot alert emails, read-only.
# Gmail: turn on 2-Step Verification, then Google Account > Security > App passwords.
# Best: send alerts to a separate Gmail used only for alerts, and put that one here.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# ALERT_SENDERS=upwork.com,f5bot.com
